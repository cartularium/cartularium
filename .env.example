# Repo-local environment variables. Copy this file to `.env` (gitignored)
# and fill in real values. Scripts that need these will source `.env`
# automatically; you don't need to export them manually.
#
# These are NOT the wrangler dev secrets — those live in
# ~/.config/cartularium/dev/edit-shell.dev.vars per DEVELOPMENT.md.
# `.env` here is for repo-tooling secrets (CI-equivalent operations
# you run from your laptop).

# scripts/cf-pages-sync-watch.sh — Cloudflare Pages watch-path management.
# Token: dash.cloudflare.com/profile/api-tokens → Create Custom Token
#   permission: Account · Cloudflare Pages · Edit
#   resource:   Specific account (the one matching CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
