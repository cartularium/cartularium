{
  "name": "sheets-wiki",
  "description": "sheets.wiki — wiki / encyclopaedia for spreadsheet practice. Built on Quartz.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com> (upstream Quartz); cartularium contributors",
  "license": "MIT",
  "homepage": "https://sheets.wiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/cartularium/cartularium.git",
    "directory": "packages/sheets-wiki"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "build": "pnpm --filter @cartularium/contracts run build && pnpm --filter assay run build:manifest && pnpm --filter @cartularium/sheets-wiki-editor run build && ./quartz/bootstrap-cli.mjs build && node ./scripts-build/copy-editor.mjs",
    "serve": "pnpm --filter @cartularium/contracts run build && ./quartz/bootstrap-cli.mjs build --serve --port 8081",
    "docs": "pnpm --filter @cartularium/contracts run build && ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "check": "pnpm --filter @cartularium/contracts run build && tsc --noEmit && prettier . --check",
    "format": "prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1"
  },
  "engines": {
    "npm": ">=9.3.1",
    "node": ">=20"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@cartularium/brand": "workspace:*",
    "@cartularium/chrome": "workspace:*",
