    }
  },
  "gsheets.json": {
    "engine": "gsheets",
    "description": "Google Sheets via Sheets API. Native dynamic arrays since 2022; broadcasting requires ARRAYFORMULA wrap for explicit array operators.",
    "features": {
      "broadcasting": {
        "support": "wrapped",
        "adapter": "arrayformula-wrap"
      },
      "dynamic-arrays": {
        "support": "native"
      },
      "lambda": {
        "support": "native"
      },
      "higher-order-lambda": {
        "support": "native"
      },
      "regex": {
        "support": "native"
      },
      "external-io": {
        "support": "native"
      },
      "volatile": {
        "support": "native"
      },
      "iterative-calc": {
        "support": "native"
      },
      "structured-refs": {
        "support": "absent"
      },
      "let-bindings": {
        "support": "native"
      },
      "implicit-intersection": {
        "support": "absent"
      },
      "spill-blocking": {
        "support": "absent",
        "note": "GSheets overwrites instead of blocking"
      }
    }
  },
