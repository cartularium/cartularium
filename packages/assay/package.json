{
  "name": "assay",
  "version": "0.1.0",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build"
  ],
  "bin": {
    "assay": "build/cli.js"
  },
  "scripts": {
    "build": "pnpm --filter @cartularium/drivers run build && tsc && node scripts/copy-assets.mjs",
    "build:manifest": "pnpm run build && mkdir -p build/site && node build/cli.js manifest --output build/site/manifest.json",
    "serve": "pnpm build && node build/cli.js catalogue --serve",
    "test": "vitest run",
    "check": "pnpm --filter @cartularium/drivers run build && tsc --noEmit",
    "clean": "rm -rf build *.tsbuildinfo"
  },
  "dependencies": {
    "@cartularium/brand": "workspace:*",
    "@cartularium/chrome": "workspace:*",
    "@cartularium/contracts": "workspace:*",
    "@cartularium/drivers": "workspace:*",
    "eta": "^4.6.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
