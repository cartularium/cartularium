# Local dev secrets for `wrangler dev` of cartularium-edit-shell.
# Copy this file to .dev.vars (ignored by git) and fill in real values.
#
# These are the same secrets used by the deployed Worker. If you've forgotten
# the values, the Client ID is visible in the App's settings page; the Client
# Secret can be regenerated there too. The private key was downloaded as a .pem
# when the App was created; re-download or generate a new one in App settings
# under "Private keys".

# GitHub App credentials. The Client ID and Client Secret are visible in the
# App's settings page. The private key was downloaded as a .pem when the App
# was created — paste its contents inline below, with newlines escaped as \n
# so the value is a single line. Wrangler parses these as plain strings.
GITHUB_APP_CLIENT_ID=Iv23liXXXXXXXXXXXXXX
GITHUB_APP_CLIENT_SECRET=ghs_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# Cookie scope for local dev. Empty means "scope to the response's host
# (localhost:8083 after Vite proxy)" — matches the conditional handling in
# packages/edit-shell/src/auth/cookie.ts. Production wrangler.toml sets
# COOKIE_DOMAIN=".sheets.wiki" via [vars].
COOKIE_DOMAIN=

# Allowed origins for the Origin header check on mutating requests. In local
# dev, allow the editor's Vite origin.
ALLOWED_ORIGINS=http://localhost:8083

# Bearer used by the local preview-worker (pnpm dev:runner) to authenticate
# against the local edit-shell. Auto-generated by `pnpm setup:dev` if left
# empty. Local-only secret; safe to leave blank in the committed example.
ASSAY_RUNNER_TOKEN=
