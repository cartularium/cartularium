{
  "name": "@cartularium/ludus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:formula-syntax": "pnpm --filter @cartularium/formula-syntax run build",
    "gnarly": "tsx spike/gnarly.ts",
    "roundtrip": "tsx spike/roundtrip.ts",
    "template": "tsx src/cli-template.ts",
    "oracle": "tsx src/cli-oracle.ts",
    "judge": "pnpm run build:formula-syntax && tsx src/cli-judge.ts",
    "selftest": "pnpm run build:formula-syntax && tsx src/cli-selftest.ts",
    "login": "tsx src/cli-login.ts",
    "verify:identity": "tsx src/cli-verify.ts",
    "verify:live": "tsx src/cli-smoke-live.ts",
    "verify:named-functions": "pnpm run build:formula-syntax && tsx spike/named-function-differential.ts",
    "test": "pnpm run build:formula-syntax && tsx --test src/*.test.ts",
    "check": "pnpm run build:formula-syntax && tsc --noEmit",
    "build:site": "node site/build.mjs",
    "serve:site": "node site/serve.mjs",
    "build:worker-problems": "node worker/build-problems.mjs",
    "deploy:site": "LUDUS_SERVICE_URL=https://ludus-judge.astral-b83.workers.dev node site/build.mjs && wrangler pages deploy public --project-name ludus --branch main --commit-dirty=true && node site/check-live.mjs",
    "deploy:worker": "pnpm run build:formula-syntax && node worker/build-problems.mjs && wrangler deploy",
    "check:worker": "pnpm run build:formula-syntax && node worker/build-problems.mjs && tsc -p worker",
    "dev:worker": "pnpm run build:formula-syntax && node worker/build-problems.mjs && node worker/make-dev-vars.mjs && wrangler dev --local"
  },
  "dependencies": {
    "@cartularium/brand": "workspace:*",
    "@cartularium/chrome": "workspace:*",
    "@cartularium/formula-syntax": "workspace:*",
    "fflate": "0.7.4",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250701.0",
    "@types/node": "^22.0.0",
    "sass": "^1.83.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
